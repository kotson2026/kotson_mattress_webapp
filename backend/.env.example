# ── Database Provider Configuration ──────────────────────────────────────────
# Options:
#   "supabase" -> Production / Staging authoritative PostgreSQL (fails safely if connection fails)
#   "local"    -> Isolated local development fallback persistence
DATABASE_PROVIDER=supabase

# ── Supabase & PostgreSQL (Production Authoritative Data Platform) ─────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres



# Security & CORS
CORS_ORIGINS=*
APP_URL=http://localhost:3000
APP_TZ=Asia/Kolkata

# Admin & Owner Credentials
SEED_OWNER_PASSWORD=change_this_to_a_secure_password
OWNER_EMAIL=hello@kotsonmattress.com

# Razorpay Payment Gateway
# Obtain these from Razorpay Dashboard (Settings > API Keys)
# Use 'rzp_test_...' for test mode or 'rzp_live_...' for production
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Razorpay Webhook Secret
# Set after configuring the webhook in Razorpay Dashboard (Developers > Webhooks)
# Webhook URL: https://<your-domain>/api/checkout/webhook
# Secret configured here MUST match the secret configured in Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── MSG91 OTP Verification (Server-Side Authoritative Verification) ───────────
# Obtain this from MSG91 Dashboard (Authkey). Kept server-side ONLY.
MSG91_AUTH_KEY=576374A5GFS6nYFS6abb7861P1

