# ── Database Provider Configuration ──────────────────────────────────────────
# Options:
#   "supabase" -> Production / Staging authoritative PostgreSQL (fails safely if connection fails)
#   "local"    -> Isolated local development fallback persistence
DATABASE_PROVIDER=supabase

# ── Supabase & PostgreSQL (Production Authoritative Data Platform) ─────────────
# Use the direct connection string (or session pooler port 5432) from Supabase Dashboard > Settings > Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DB_POOL_MIN=1
DB_POOL_MAX=4
DB_TIMEOUT=30.0
UVICORN_WORKERS=1

# Optional Supabase REST API keys (not required for direct asyncpg PostgreSQL adapter)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Security, CORS & Cross-Origin Cookies ─────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment URL + local dev)
CORS_ORIGINS=https://kotson-mattress.vercel.app,http://localhost:5173
APP_URL=https://kotson-mattress.vercel.app
APP_TZ=Asia/Kolkata
ENV=staging

# Cross-origin cookie settings (Set to true/none for HTTPS cross-origin frontend-backend deployments)
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# ── Admin & Owner Credentials ────────────────────────────────────────────────
# Seed password used ONLY during initial database bootstrap to create the owner admin account
# Once Owner Admin exists, this can be safely removed from environment.
SEED_OWNER_PASSWORD=change_this_to_a_secure_random_password
OWNER_EMAIL=hello@kotsonmattress.com
# OWNER_PHONE is optional. Leave unset unless an authoritative phone is explicitly provided.
# OWNER_PHONE=+919876543210

# ── Razorpay Payment Gateway (TEST MODE ONLY DURING DEPLOYMENT) ───────────────
# IMPORTANT: Do NOT configure Razorpay Live credentials during deployment.
# Live credentials will be added in a separate dedicated phase after all deployment
# tests pass. Keep in Test Mode ('rzp_test_...').
RAZORPAY_KEY_ID=rzp_live_TiwS1Yi9Zc1gz3
RAZORPAY_KEY_SECRET=OLJ0AnSJ8Zq9YJme4FaODebz
RAZORPAY_WEBHOOK_SECRET=Kotson@2026Kotson@2026

# ── MSG91 OTP Verification (Server-Side Authoritative Verification) ───────────
# Server-side authkey for sending & verifying customer login/signup OTPs
MSG91_AUTH_KEY=your_msg91_auth_key_here


